<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="cpu-page">
    <property name="orientation">vertical</property>

    <child>
      <object class="GtkScrolledWindow">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>

        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">24</property>

            <child>
              <object class="AdwPreferencesGroup">
                <property name="title" translatable="yes">CPU Control</property>
                <property name="description" translatable="yes">Manage CPU governor, frequency scaling, and performance tuning.</property>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup" id="cpu-governor-section">
                <property name="title" translatable="yes">CPU Frequency Governor</property>
                <child>
                  <object class="AdwActionRow" id="governor-row">
                    <property name="title" translatable="yes">Scaling Governor</property>
                    <property name="subtitle" translatable="yes">Controls how the CPU scales its frequency. 'performance' runs at max, 'powersave' at min, 'ondemand' ramps up on demand.</property>
                    <child type="widget">
                      <object class="GtkDropDown" id="governor-dropdown">
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item translatable="yes">performance</item>
                              <item translatable="yes">powersave</item>
                              <item translatable="yes">ondemand</item>
                              <item translatable="yes">conservative</item>
                              <item translatable="yes">schedutil</item>
                              <item translatable="yes">userspace</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="governor-current-row">
                    <property name="title" translatable="yes">Current Governor</property>
                    <child type="widget">
                      <object class="GtkLabel" id="governor-current-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup" id="cpu-frequency-section">
                <property name="title" translatable="yes">Frequency Limits</property>
                <child>
                  <object class="AdwActionRow" id="min-freq-row">
                    <property name="title" translatable="yes">Minimum Frequency</property>
                    <property name="subtitle" translatable="yes">Lowest CPU frequency in kHz. Requires userspace governor for per-core control.</property>
                    <child type="widget">
                      <object class="GtkSpinButton" id="min-freq-spin">
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">9999999</property>
                            <property name="step-increment">100000</property>
                          </object>
                        </property>
                        <property name="width-request">120</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="max-freq-row">
                    <property name="title" translatable="yes">Maximum Frequency</property>
                    <property name="subtitle" translatable="yes">Highest CPU frequency in kHz. (e.g. 2200000 = 2.2 GHz)</property>
                    <child type="widget">
                      <object class="GtkSpinButton" id="max-freq-spin">
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">9999999</property>
                            <property name="step-increment">100000</property>
                          </object>
                        </property>
                        <property name="width-request">120</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="cur-freq-row">
                    <property name="title" translatable="yes">Current Frequency</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cur-freq-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup" id="cpu-info-section">
                <property name="title" translatable="yes">CPU Information</property>
                <child>
                  <object class="AdwActionRow" id="cpu-cores-row">
                    <property name="title" translatable="yes">Logical Cores</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-cores-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow" id="cpu-arch-row">
                    <property name="title" translatable="yes">Architecture</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-arch-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Lighting Controls ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu-lighting-section">
                <child>
                  <object class="GtkBox" id="cpu-lighting-header">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">4</property>
                    <child>
                      <object class="GtkLabel" id="cpu-lighting-title">
                        <property name="label" translatable="yes">Lighting Controls</property>
                        <property name="halign">start</property>
                        <property name="hexpand">True</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="cpu-lighting-status">
                    <property name="halign">start</property>
                    <property name="hexpand">True</property>
                    <property name="wrap">True</property>
                    <property name="max-width-chars">60</property>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="GtkActionBar">
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <child type="center">
          <object class="GtkButton" id="cpu-save-btn">
            <property name="label" translatable="yes">Save CPU Configuration</property>
            <property name="halign">center</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>

  </object>
</interface>