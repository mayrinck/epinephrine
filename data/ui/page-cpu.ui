<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="cpu-page">
    <property name="orientation">vertical</property>

    <child>
      <object class="GtkScrolledWindow">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="hscrollbar-policy">never</property>
        <property name="propagate-natural-width">True</property>
        <property name="propagate-natural-height">True</property>

        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">16</property>
            <property name="margin-end">16</property>
            <property name="margin-top">16</property>
            <property name="margin-bottom">16</property>

            <!-- ===== Branding ===== -->
            <child>
              <object class="GtkBox" id="cpu_branding_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">16</property>

                <child>
                  <object class="GtkImage" id="cpu_brand_icon">
                    <property name="icon-name">cpu-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="valign">start</property>
                  </object>
                </child>

                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="hexpand">True</property>

                    <child>
                      <object class="GtkLabel" id="cpu_name_label">
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">CPU</property>
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkLabel" id="cpu_vendor_label">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes"></property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="cpu_codename_label">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes"></property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Monitor Group ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu_monitor_group">
                <property name="title" translatable="yes">Monitor</property>

                <child>
                  <object class="GtkBox" id="cpu_monitor_panel">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">8</property>
                    <property name="margin-bottom">8</property>

                    <child>
                      <object class="GtkDrawingArea" id="cpu_monitor_graph">
                        <property name="hexpand">True</property>
                        <property name="height-request">160</property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox" id="cpu_monitor_left">
                        <property name="orientation">vertical</property>
                        <property name="spacing">1</property>
                      </object>
                    </child>

                  </object>
                </child>

              </object>
            </child>

            <!-- ===== Specifications ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu-specs-section">
                <property name="title" translatable="yes">Specifications</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Socket</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-socket-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Architecture</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-arch-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Family / Model / Stepping</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-family-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Cores / Threads</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-cores-threads-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">BogoMIPS</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-bogomips-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Microcode</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-microcode-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Base Frequency</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-base-freq-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Boost Frequency</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-boost-freq-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Instructions</property>
                    <property name="subtitle" translatable="yes">CPU feature flags</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-flags-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                        <property name="wrap">True</property>
                        <property name="max-width-chars">60</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Caches ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu-caches-section">
                <property name="title" translatable="yes">Caches</property>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">L1 Data</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-l1d-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">L1 Instruction</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-l1i-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">L2</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-l2-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">L3</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cpu-l3-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Vulnerabilities ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu-vulns-section">
                <property name="title" translatable="yes">Security</property>
              </object>
            </child>

            <!-- ===== CPU Control ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu-governor-section">
                <property name="title" translatable="yes">CPU Control</property>
                <child>
                  <object class="AdwActionRow" id="governor-row">
                    <property name="title" translatable="yes">Scaling Governor</property>
                    <property name="subtitle" translatable="yes">Controls how the CPU scales its frequency.</property>
                    <child type="widget">
                      <object class="GtkDropDown" id="governor-dropdown">
                        <property name="model">
                          <object class="GtkStringList" id="governor-stringlist">
                            <items>
                              <item translatable="yes">performance</item>
                              <item translatable="yes">powersave</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Current Governor</property>
                    <child type="widget">
                      <object class="GtkLabel" id="governor-current-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Minimum Frequency (kHz)</property>
                    <child type="widget">
                      <object class="GtkSpinButton" id="min-freq-spin">
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">9999999</property>
                            <property name="step-increment">100000</property>
                          </object>
                        </property>
                        <property name="width-request">120</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Maximum Frequency (kHz)</property>
                    <child type="widget">
                      <object class="GtkSpinButton" id="max-freq-spin">
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0</property>
                            <property name="upper">9999999</property>
                            <property name="step-increment">100000</property>
                          </object>
                        </property>
                        <property name="width-request">120</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwActionRow">
                    <property name="title" translatable="yes">Current Frequency</property>
                    <child type="widget">
                      <object class="GtkLabel" id="cur-freq-label">
                        <property name="halign">end</property>
                        <property name="hexpand">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Lighting Controls ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu-lighting-section">
                <child>
                  <object class="GtkBox" id="cpu-lighting-header">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">4</property>
                    <child>
                      <object class="GtkLabel" id="cpu-lighting-title">
                        <property name="label" translatable="yes">Lighting Controls</property>
                        <property name="halign">start</property>
                        <property name="hexpand">True</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="cpu-lighting-status">
                    <property name="halign">start</property>
                    <property name="hexpand">True</property>
                    <property name="wrap">True</property>
                    <property name="max-width-chars">60</property>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="GtkActionBar">
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <child type="center">
          <object class="GtkButton" id="cpu-save-btn">
            <property name="label" translatable="yes">Save CPU Configuration</property>
            <property name="halign">center</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>

  </object>
</interface>
