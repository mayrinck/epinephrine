<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="cpu-page">
    <property name="orientation">vertical</property>

    <child>
      <object class="GtkScrolledWindow">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="hscrollbar-policy">never</property>
        <property name="propagate-natural-width">True</property>
        <property name="propagate-natural-height">True</property>

        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">16</property>
            <property name="margin-end">16</property>
            <property name="margin-top">16</property>
            <property name="margin-bottom">16</property>

            <!-- ===== Branding ===== -->
            <child>
              <object class="GtkBox" id="cpu_branding_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">16</property>

                <child>
                  <object class="GtkImage" id="cpu_brand_icon">
                    <property name="icon-name">cpu-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="valign">start</property>
                  </object>
                </child>

                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">2</property>
                    <property name="hexpand">True</property>

                    <child>
                      <object class="GtkLabel" id="cpu_name_label">
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">CPU</property>
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkLabel" id="cpu_vendor_label">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes"></property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="cpu_codename_label">
                            <property name="halign">start</property>
                            <property name="label" translatable="yes"></property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Monitor Group (always visible) ===== -->
            <child>
              <object class="AdwPreferencesGroup" id="cpu_monitor_group">
                <property name="title" translatable="yes">Monitor</property>

                <child>
                  <object class="GtkBox" id="cpu_monitor_panel">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">8</property>
                    <property name="margin-bottom">8</property>

                    <child>
                      <object class="GtkDrawingArea" id="cpu_monitor_graph">
                        <property name="hexpand">True</property>
                        <property name="height-request">160</property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox" id="cpu_monitor_left">
                        <property name="orientation">vertical</property>
                        <property name="spacing">1</property>
                      </object>
                    </child>

                  </object>
                </child>

              </object>
            </child>

            <!-- ===== CPU Management (collapsible — right after monitor) ===== -->
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwExpanderRow" id="cpu-section-control-toggle">
                    <property name="title" translatable="yes">CPU Management</property>
                    <property name="subtitle" translatable="yes">Governor, frequency scaling</property>
                    <child>
                      <object class="AdwActionRow" id="governor-row">
                        <property name="title" translatable="yes">CPU Governor</property>
                        <property name="subtitle" translatable="yes">Define how the processes will be managed by the system.</property>
                        <child type="widget">
                          <object class="GtkDropDown" id="governor-dropdown">
                            <property name="width-request">160</property>
                            <property name="model">
                              <object class="GtkStringList" id="governor-stringlist">
                                <items>
                                  <item translatable="yes">performance</item>
                                  <item translatable="yes">powersave</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Minimum Frequency (kHz)</property>
                        <child type="widget">
                          <object class="GtkSpinButton" id="min-freq-spin">
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">9999999</property>
                                <property name="step-increment">100000</property>
                              </object>
                            </property>
                            <property name="width-request">120</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Maximum Frequency (kHz)</property>
                        <child type="widget">
                          <object class="GtkSpinButton" id="max-freq-spin">
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">9999999</property>
                                <property name="step-increment">100000</property>
                              </object>
                            </property>
                            <property name="width-request">120</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cur-freq-row">
                        <property name="title" translatable="yes">Current Frequency</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Specifications (collapsible) ===== -->
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwExpanderRow" id="cpu-section-specs-toggle">
                    <property name="title" translatable="yes">Specifications</property>
                    <property name="subtitle" translatable="yes">Socket, architecture, cores, frequencies</property>
                    <child>
                      <object class="AdwActionRow" id="cpu-socket-row">
                        <property name="title" translatable="yes">Socket</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-arch-row">
                        <property name="title" translatable="yes">Architecture</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-family-row">
                        <property name="title" translatable="yes">Family / Model / Stepping</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-cores-row">
                        <property name="title" translatable="yes">Cores / Threads</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-bogomips-row">
                        <property name="title" translatable="yes">BogoMIPS</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-microcode-row">
                        <property name="title" translatable="yes">Microcode</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-base-freq-row">
                        <property name="title" translatable="yes">Base Frequency</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-boost-freq-row">
                        <property name="title" translatable="yes">Boost Frequency</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-flags-row">
                        <property name="title" translatable="yes">Instructions</property>
                        <property name="subtitle" translatable="yes">CPU feature flags</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Caches (collapsible) ===== -->
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwExpanderRow" id="cpu-section-caches-toggle">
                    <property name="title" translatable="yes">Caches</property>
                    <property name="subtitle" translatable="yes">L1, L2, L3 cache sizes</property>
                    <child>
                      <object class="AdwActionRow" id="cpu-l1d-row">
                        <property name="title" translatable="yes">L1 Data</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-l1i-row">
                        <property name="title" translatable="yes">L1 Instruction</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-l2-row">
                        <property name="title" translatable="yes">L2</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="cpu-l3-row">
                        <property name="title" translatable="yes">L3</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- ===== Security / Vulnerabilities (collapsible) ===== -->
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwExpanderRow" id="cpu-section-security-toggle">
                    <property name="title" translatable="yes">Security</property>
                    <property name="subtitle" translatable="yes">CPU vulnerability mitigations</property>
                    <child>
                      <object class="AdwPreferencesGroup" id="cpu-vulns-section">
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

  </object>
</interface>
