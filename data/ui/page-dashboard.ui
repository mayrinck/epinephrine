<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="dashboard-page">
    <property name="orientation">vertical</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>

    <child>
      <object class="GtkSpinner" id="dash-spinner">
        <property name="halign">center</property>
        <property name="valign">center</property>
        <property name="width-request">36</property>
        <property name="height-request">36</property>
        <property name="margin-top">48</property>
      </object>
    </child>

    <child>
      <object class="GtkScrolledWindow" id="dash-scroll">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-bottom">12</property>

            <!-- Recent Games header -->
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">4</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Recent Games</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">True</property>
                    <style>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="see-more-button">
                    <property name="label" translatable="yes">Go to library</property>
                    <style>
                      <class name="flat"/>
                      <class name="accent-btn"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <!-- Recent games list -->
            <child>
              <object class="GtkBox" id="recent-games-box">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="homogeneous">False</property>
              </object>
            </child>

            <!-- Gaming Score (below recent games) -->
            <child>
              <object class="GtkBox" id="gaming-score-box">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="margin-top">8</property>
                <property name="margin-bottom">4</property>
                <property name="visible">False</property>
                <style>
                  <class name="gaming-score-card"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">16</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        <property name="hexpand">True</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Gaming Score</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="title-2"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Check how your PC performs with modern gaming</property>
                            <property name="xalign">0</property>
                            <property name="opacity">0.7</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkSpinner" id="gaming-score-spinner">
                            <property name="width-request">32</property>
                            <property name="height-request">32</property>
                            <property name="halign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">16</property>
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkLabel" id="gaming-score-tier">
                                <property name="halign">center</property>
                                <property name="visible">False</property>
                                <style>
                                  <class name="gaming-score-tier"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="gaming-score-label">
                                <property name="label">—</property>
                                <style>
                                  <class name="gaming-score-value"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="gaming-score-details">
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="visible">False</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">CPU</property>
                            <property name="width-request">90</property>
                            <property name="halign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkProgressBar" id="gaming-score-cpu-bar">
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">GPU</property>
                            <property name="width-request">90</property>
                            <property name="halign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkProgressBar" id="gaming-score-gpu-bar">
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">RAM</property>
                            <property name="width-request">90</property>
                            <property name="halign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkProgressBar" id="gaming-score-ram-bar">
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Monitor</property>
                            <property name="width-request">90</property>
                            <property name="halign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkProgressBar" id="gaming-score-monitor-bar">
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="gaming-score-footer">
                    <property name="label" translatable="yes">This score is a reference and should not be taken without considering the context of which games will be played. More modest computers can also handle various types of games, when well configured :)</property>
                    <property name="wrap">True</property>
                    <property name="xalign">0</property>
                    <property name="opacity">0.6</property>
                    <property name="visible">False</property>
                    <style>
                      <class name="gaming-score-footer"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="gaming-score-details-btn">
                    <property name="label" translatable="yes">Details</property>
                    <property name="halign">fill</property>
                    <property name="hexpand">True</property>
                    <property name="visible">False</property>
                    <style>
                      <class name="text-button"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkSeparator">
                <property name="orientation">horizontal</property>
                <property name="margin-top">4</property>
                <property name="margin-bottom">4</property>
              </object>
            </child>

            <!-- Two-column layout: Hardware Summary + Gaming Components -->
            <child>
              <object class="GtkBox" id="hw-gaming-columns">
                <property name="orientation">horizontal</property>
                <property name="spacing">16</property>
                <property name="margin-top">4</property>

                <!-- Left column: Hardware Summary -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="hexpand">True</property>

                    <!-- Hardware Summary header -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="margin-bottom">4</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Hardware Summary</property>
                            <property name="xalign">0</property>
                            <property name="hexpand">True</property>
                            <style>
                              <class name="title-3"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="hw-goto-button">
                            <property name="label" translatable="yes">Manage</property>
                            <style>
                              <class name="flat"/>
                              <class name="accent-btn"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Hardware card (no title inside) -->
                    <child>
                      <object class="GtkBox" id="hw-card">
                        <property name="orientation">vertical</property>
                        <style>
                          <class name="dashboard-card"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Right column: Gaming Components -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="hexpand">True</property>

                    <!-- Gaming Components header -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="margin-bottom">4</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Gaming Components</property>
                            <property name="xalign">0</property>
                            <property name="hexpand">True</property>
                            <style>
                              <class name="title-3"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Gaming card (no title inside) -->
                    <child>
                      <object class="GtkBox" id="gr-card">
                        <property name="orientation">vertical</property>
                        <style>
                          <class name="dashboard-card"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
