<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="mouse-page">
    <property name="orientation">vertical</property>

    <child>
      <object class="GtkScrolledWindow">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>

        <child>
          <object class="GtkBox" id="mouse-scroll-box">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">24</property>

            <!-- Branding header (from MICE_INDEX.md lookup) -->
            <child>
              <object class="GtkBox" id="mouse_branding_box">
                <property name="orientation">horizontal</property>
                <property name="spacing">16</property>

                <child>
                  <object class="GtkImage" id="mouse_brand_icon">
                    <property name="icon-name">input-mouse-symbolic</property>
                    <property name="pixel-size">64</property>
                    <property name="valign">start</property>
                  </object>
                </child>

                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>
                    <property name="hexpand">True</property>

                    <child>
                      <object class="GtkLabel" id="mouse_name_label">
                        <property name="halign">start</property>
                        <property name="label" translatable="yes">Mouse</property>
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkLabel" id="mouse_release_label">
                        <property name="halign">start</property>
                        <property name="label" translatable="yes"></property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>

                  </object>
                </child>

                <child>
                  <object class="GtkButton" id="mouse-website-btn">
                    <property name="label" translatable="yes">Product Website</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="flat"/>
                      <class name="accent"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <!-- Device Information (built programmatically in mouse_page_new) -->
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwExpanderRow" id="mouse-device-section">
                    <property name="title" translatable="yes">Device Information</property>
                    <property name="subtitle" translatable="yes">Hardware identification and capabilities.</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- G300s sections inserted here dynamically -->
            <child>
              <object class="GtkBox" id="g300-container">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
              </object>
            </child>

            <!-- Acceleration and Speed (libinput) -->
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwExpanderRow" id="mouse-accel-section">
                    <property name="title" translatable="yes">Acceleration and Speed</property>
                    <property name="subtitle" translatable="yes">Configure mouse acceleration, speed, and natural scrolling via libinput.</property>
                    <child>
                      <object class="AdwActionRow" id="mouse-speed-row">
                        <property name="title" translatable="yes">Pointer Speed</property>
                        <property name="subtitle" translatable="yes">Mouse cursor speed. Range -1 (slowest) to 1 (fastest). 0 = default.</property>
                        <child type="widget">
                          <object class="GtkScale" id="mouse-speed-scale">
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">-1</property>
                                <property name="upper">1</property>
                                <property name="step-increment">0.1</property>
                                <property name="value">0</property>
                              </object>
                            </property>
                            <property name="width-request">180</property>
                            <property name="draw-value">True</property>
                            <property name="digits">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="mouse-accel-row">
                        <property name="title" translatable="yes">Acceleration Profile</property>
                        <property name="subtitle" translatable="yes">'flat' = no acceleration, 'adaptive' = standard, 'none' = raw.</property>
                        <child type="widget">
                          <object class="GtkDropDown" id="mouse-accel-dropdown">
                            <property name="model">
                              <object class="GtkStringList">
                                <items>
                                  <item translatable="yes">none</item>
                                  <item translatable="yes">flat</item>
                                  <item translatable="yes">adaptive</item>
                                </items>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="mouse-natural-scroll-row">
                        <property name="title" translatable="yes">Natural Scrolling</property>
                        <property name="subtitle" translatable="yes">Reverse scroll direction (content follows fingers).</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </child>

      </object>
    </child>

    <child>
      <object class="GtkActionBar">
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <child type="center">
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">12</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkButton" id="mouse-save-btn">
                <property name="label" translatable="yes">Apply Mouse Settings</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="mouse-save-g300-btn">
                <property name="label" translatable="yes">Save to Hardware</property>
                <property name="visible">False</property>
                <style>
                  <class name="accent"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="mouse-restore-factory-btn">
                <property name="label" translatable="yes">Restore Factory Profiles</property>
                <property name="visible">False</property>
                <style>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </object>
</interface>
