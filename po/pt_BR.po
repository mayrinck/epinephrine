#: data/ui/page-gamemode.ui:12
msgid "GameMode Settings"
msgstr "Configurações do GameMode"

#: data/ui/page-gamemode.ui:13
msgid ""
"Configure Feral GameMode for optimal gaming performance. GameMode applies "
"system-level optimizations when games are running."
msgstr ""
"Configure o Feral GameMode para desempenho ideal nos jogos. O GameMode "
"aplica otimizações de nível de sistema quando jogos estão rodando."

#: data/ui/page-gamemode.ui:22
msgid "Process Priority"
msgstr "Prioridade do Processo"

#: data/ui/page-gamemode.ui:23
msgid "Defines the priority of the processes while gamemode is active."
msgstr "Define a prioridade dos processos enquanto o gamemode está ativo."

#: data/ui/page-gamemode.ui:26
msgid "Nice Value"
msgstr "Valor Nice"

#: data/ui/page-gamemode.ui:27
msgid "Process priority (-20 = highest, 19 = lowest). Default: 0"
msgstr "Prioridade do processo (-20 = mais alta, 19 = mais baixa). Padrão: 0"

#: data/ui/page-gamemode.ui:46
msgid "I/O Priority"
msgstr "Prioridade de Entrada/Saída"

#: data/ui/page-gamemode.ui:47
msgid "Disk I/O scheduling class. Default: none"
msgstr "Classe de agendamento de E/S do disco. Padrão: nenhuma"

#: data/ui/page-gamemode.ui:52
msgid "None"
msgstr "Nenhuma"

#: data/ui/page-gamemode.ui:53
msgid "Realtime"
msgstr "Tempo real"

#: data/ui/page-gamemode.ui:54
msgid "Best-effort"
msgstr "Melhor esforço"

#: data/ui/page-gamemode.ui:55
msgid "Idle"
msgstr "Ocioso"

#: data/ui/page-gamemode.ui:72
msgid "CPU Settings"
msgstr "Configurações da CPU"

#: data/ui/page-gamemode.ui:73
msgid "Configure the behavior of your CPU while gamemode is active."
msgstr "Configure o comportamento da CPU enquanto o gamemode está ativo."

#: data/ui/page-gamemode.ui:76
msgid "CPU Governor"
msgstr "Governador da CPU"

#: data/ui/page-gamemode.ui:77
msgid ""
"CPU frequency scaling policy. Performance mode keeps max frequency. Default: "
"performance"
msgstr ""
"Política de escala de frequência da CPU. Modo performance mantém frequência "
"máxima. Padrão: performance"

#: data/ui/page-gamemode.ui:82 data/ui/page-gamemode.ui:224
#: data/ui/page-mangohud.ui:281
msgid "Performance"
msgstr "Performance"

#: data/ui/page-gamemode.ui:83 data/ui/page-gamemode.ui:225
msgid "Powersave"
msgstr "Economia de energia"

#: data/ui/page-gamemode.ui:84
msgid "Schedutil"
msgstr "Schedutil"

#: data/ui/page-gamemode.ui:93
msgid "CPU Min Frequency"
msgstr "Frequência Mínima da CPU"

#: data/ui/page-gamemode.ui:94
msgid "Minimum CPU frequency in kHz. 0 = no minimum. Default: 0"
msgstr "Frequência mínima da CPU em kHz. 0 = sem mínimo. Padrão: 0"

#: data/ui/page-gamemode.ui:113
msgid "CPU Max Frequency"
msgstr "Frequência Máxima da CPU"

#: data/ui/page-gamemode.ui:114
msgid "Maximum CPU frequency in kHz. 0 = no maximum. Default: 0"
msgstr "Frequência máxima da CPU em kHz. 0 = sem máximo. Padrão: 0"

#: data/ui/page-gamemode.ui:133
msgid "CPU Performance Percentage"
msgstr "Porcentagem de Performance da CPU"

#: data/ui/page-gamemode.ui:134
msgid "CPU performance level (0-100). Higher = more aggressive. Default: 100"
msgstr ""
"Nível de performance da CPU (0-100). Maior = mais agressivo. Padrão: 100"

#: data/ui/page-gamemode.ui:161
msgid "Scheduler"
msgstr "Agendador"

#: data/ui/page-gamemode.ui:162
msgid "Define the scheduler behavior while gamemode is active."
msgstr "Define o comportamento do agendador enquanto o gamemode está ativo."

#: data/ui/page-gamemode.ui:165
msgid "Scheduler Priority"
msgstr "Prioridade do Agendador"

#: data/ui/page-gamemode.ui:166
msgid "Process scheduler priority (-20 to 19). Default: 0"
msgstr "Prioridade do agendador de processos (-20 a 19). Padrão: 0"

#: data/ui/page-gamemode.ui:185
msgid "I/O Weight"
msgstr "Peso de E/S"

#: data/ui/page-gamemode.ui:186
msgid ""
"I/O scheduling weight (1-10000). Higher = more I/O priority. Default: 100"
msgstr ""
"Peso de agendamento de E/S (1-10000). Maior = mais prioridade de E/S. "
"Padrão: 100"

#: data/ui/page-gamemode.ui:214
msgid "GPU Settings"
msgstr "Configurações da GPU"

#: data/ui/page-gamemode.ui:215
msgid "Configure the behavior of the GPU while gamemode is active"
msgstr "Configure o comportamento da GPU enquanto o gamemode está ativo"

#: data/ui/page-gamemode.ui:218
msgid "GPU Governor"
msgstr "Governador da GPU"

#: data/ui/page-gamemode.ui:219
msgid "GPU frequency scaling policy. Default: performance"
msgstr "Política de escala de frequência da GPU. Padrão: performance"

#: data/ui/page-gamemode.ui:226
msgid "Default"
msgstr "Padrão"

#: data/ui/page-gamemode.ui:235
msgid "Apply GPU Governor"
msgstr "Aplicar Governador da GPU"

#: data/ui/page-gamemode.ui:236
msgid "Enable GPU governor override when GameMode is active"
msgstr "Ativar sobrescrita do governador da GPU quando o GameMode estiver ativo"

#: data/ui/page-gamemode.ui:250
msgid "Tweaks"
msgstr "Ajustes"

#: data/ui/page-gamemode.ui:251
msgid ""
"System tweaks applied while GameMode is active. Changes are reverted when "
"GameMode stops."
msgstr ""
"Ajustes do sistema aplicados enquanto o GameMode está ativo. As mudanças "
"são revertidas quando o GameMode para."

#: data/ui/page-gamemode.ui:254
msgid "Disable animations"
msgstr "Desabilitar animações"

#: data/ui/page-gamemode.ui:255
msgid "System animations will not occur while gamemode is active"
msgstr "Animações do sistema não ocorrerão enquanto o gamemode estiver ativo"

#: data/ui/page-gamemode.ui:261
msgid "Disable notifications"
msgstr "Desabilitar notificações"

#: data/ui/page-gamemode.ui:262
msgid "System notification bubbles will not occur while gamemode is active"
msgstr ""
"Bolhas de notificação do sistema não ocorrerão enquanto o gamemode estiver "
"ativo"

#: data/ui/page-gamemode.ui:268
msgid "Suspend compositor"
msgstr "Suspender compositor"

#: data/ui/page-gamemode.ui:269
msgid ""
"Suspend the desktop compositor to reduce input lag and eliminate forced "
"vsync. Supported on KDE and GNOME."
msgstr ""
" suspendedor o compositor da área de trabalho para reduzir o lag de entrada "
"e eliminar vsync forçado. Suportado no KDE e GNOME."

#: data/ui/page-gamemode.ui:275
msgid "Reduce swappiness"
msgstr "Reduzir swappiness"

#: data/ui/page-gamemode.ui:276
msgid ""
"Keep data in RAM longer by reducing the kernel's tendency to swap. Safer "
"with 8 GB+ of RAM."
msgstr ""
"Mantém os dados na RAM por mais tempo reduzindo a tendência do kernel de "
"fazer swap. Mais seguro com 8 GB+ de RAM."

#: data/ui/page-gamemode.ui:282
msgid "Disable NMI watchdog"
msgstr "Desabilitar watchdog NMI"

#: data/ui/page-gamemode.ui:283
msgid ""
"Disables periodic CPU interrupt monitoring. Most useful on older CPUs to "
"reclaim a small amount of cycles."
msgstr ""
"Desabilita o monitoramento periódico de interrupções da CPU. Mais útil em "
"CPUs antigas para recuperar uma pequena quantidade de ciclos."

#: data/ui/page-gamemode.ui:289
msgid "Disable USB autosuspend"
msgstr "Desabilitar autosuspend USB"

#: data/ui/page-gamemode.ui:290
msgid ""
"Prevents USB devices from entering sleep during gameplay, reducing potential "
"input micro-lags."
msgstr ""
"Impede que dispositivos USB entrem em suspensão durante o jogo, reduzindo "
"possíveis micro-lags de entrada."

#: data/ui/page-gamemode.ui:296
msgid "Increase timer frequency"
msgstr "Aumentar frequência do timer"

#: data/ui/page-gamemode.ui:297
msgid ""
"Raises kernel timer resolution from 250 Hz to 1000 Hz for more consistent "
"frametimes."
msgstr ""
"Aumenta a resolução do timer do kernel de 250 Hz para 1000 Hz para "
"frametimes mais consistentes."

#: data/ui/page-gamemode.ui:303
msgid "Disable USB wakeup"
msgstr "Desabilitar despertar USB"

#: data/ui/page-gamemode.ui:304
msgid ""
"Prevents USB devices from waking the CPU, avoiding micro-interruptions "
"during gameplay."
msgstr ""
"Impede que dispositivos USB despertem a CPU, evitando micro-interrupções "
"durante o jogo."

#: data/ui/page-gamemode.ui:310
msgid "Reduce write cache"
msgstr "Reduzir cache de escrita"

#: data/ui/page-gamemode.ui:311
msgid ""
"Lowers kernel dirty page thresholds so writes happen more frequently, "
"reducing I/O spikes."
msgstr ""
"Reduz os limites de páginas sujas do kernel para que as escritas ocorram "
"com mais frequência, reduzindo picos de E/S."

#: data/ui/page-gamemode.ui:317
msgid "Kill background indexers"
msgstr "Matar indexadores em segundo plano"

#: data/ui/page-gamemode.ui:318
msgid ""
"Terminates file indexers (baloo, tracker) that consume CPU and disk during "
"gameplay."
msgstr ""
"Termina indexadores de arquivos (baloo, tracker) que consomem CPU e disco "
"durante o jogo."

#: data/ui/page-gamemode.ui:324
msgid "Increase scheduler limit"
msgstr "Aumentar limite do agendador"

#: data/ui/page-gamemode.ui:325
msgid ""
"Allows real-time processes to use a larger CPU slice. Useful for audio/"
"PipeWire and Wine."
msgstr ""
"Permite que processos em tempo real usem uma fatia maior da CPU. Útil para "
"áudio/PipeWire e Wine."

#: data/ui/page-gamemode.ui:331
msgid "Stop auto-updaters"
msgstr "Parar atualizadores automáticos"

#: data/ui/page-gamemode.ui:332
msgid ""
"Disables packagekit and snapd during gameplay to prevent unexpected download/"
"install spikes."
msgstr ""
"Desabilita packagekit e snapd durante o jogo para prevenir picos "
"inesperados de download/instalação."

#: data/ui/page-gamemode.ui:346
msgid "Custom Scripts"
msgstr "Scripts Personalizados"

#: data/ui/page-gamemode.ui:347
msgid "Scripts that will execute every time Gamemode turns on/off"
msgstr "Scripts que serão executados toda vez que o Gamemode ligar/desligar"

#: data/ui/page-gamemode.ui:350
msgid "Startup Script"
msgstr "Script de Inicialização"

#: data/ui/page-gamemode.ui:351
msgid "Executed when GameMode activates, right before a game starts"
msgstr ""
"Executado quando o GameMode é ativado, logo antes de um jogo começar"

#: data/ui/page-gamemode.ui:355
msgid "/path/to/start.sh"
msgstr "/caminho/para/inicio.sh"

#: data/ui/page-gamemode.ui:365
msgid "Shutdown Script"
msgstr "Script de Desligamento"

#: data/ui/page-gamemode.ui:366
msgid "Executed when GameMode deactivates, after a game closes"
msgstr ""
"Executado quando o GameMode é desativado, depois que um jogo é fechado"

#: data/ui/page-gamemode.ui:370
msgid "/path/to/end.sh"
msgstr "/caminho/para/fim.sh"

#: data/ui/page-gamemode.ui:400 data/ui/page-gamescope.ui:547
#: data/ui/page-mangohud.ui:319
msgid "Restore Defaults"
msgstr "Restaurar Padrões"

#: data/ui/page-gamemode.ui:424 data/ui/page-gamescope.ui:603
#: data/ui/page-mangohud.ui:343
msgid "Save Configuration"
msgstr "Salvar Configuração"

#: data/ui/page-gamescope.ui:12
msgid "Gamescope Manager"
msgstr "Gerenciador do Gamescope"

#: data/ui/page-gamescope.ui:13
msgid ""
"Configure Gamescope parameters visually. Save your configuration as the "
"system default or copy it to use with a specific game in Steam or other "
"launchers as startup command."
msgstr ""
"Configure os parâmetros do Gamescope visualmente. Salve sua configuração "
"como padrão do sistema ou copie para usar com um jogo específico na Steam "
"ou em outros launchers como comando de inicialização."

