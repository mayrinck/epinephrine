msgstr "Linear"

#: data/ui/page-gamescope.ui:174
msgid "Nearest"
msgstr "Vizinho mais próximo"

#: data/ui/page-gamescope.ui:175
msgid "FSR"
msgstr "AMD™ FSR"

#: data/ui/page-gamescope.ui:176
msgid "NIS"
msgstr "NVIDIA™ NIS"

#: data/ui/page-gamescope.ui:177
msgid "Pixel"
msgstr "Pixel"

#: data/ui/page-gamescope.ui:186
msgid "Sharpness"
msgstr "Nitidez"

#: data/ui/page-gamescope.ui:187
msgid "0 = sharpest, 20 = blurriest (default: 2)"
msgstr "0 = mais nítido, 20 = mais borrado (padrão: 2)"

#: data/ui/page-gamescope.ui:209
msgid "Max Scale"
msgstr "Escala Máxima"

#: data/ui/page-gamescope.ui:210
msgid "Maximum scale factor (0 = no limit)"
msgstr "Fator de escala máximo (0 = sem limite)"

#: data/ui/page-gamescope.ui:232
msgid "Frame Rate"
