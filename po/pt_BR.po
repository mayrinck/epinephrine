#: data/ui/page-gamescope.ui:233
msgid "Framerate limit for the compositor."
msgstr "Limite de taxa de quadros para o compositor."

#: data/ui/page-gamescope.ui:236
msgid "Framerate Limit"
msgstr "Limite de FPS"

#: data/ui/page-gamescope.ui:237 data/ui/page-gamescope.ui:474
msgid "0 = disabled"
msgstr "0 = desabilitado"

#: data/ui/page-gamescope.ui:258
msgid "HDR and Color"
msgstr "HDR e Cor"

#: data/ui/page-gamescope.ui:259
msgid "HDR10 output, inverse tone mapping and SDR gamut settings."
msgstr ""
"Saída HDR10, mapeamento de tom inverso e configurações de gamut SDR."

#: data/ui/page-gamescope.ui:262
msgid "HDR Enabled"
msgstr "HDR Ativado"

#: data/ui/page-gamescope.ui:263
msgid "Enable HDR10 output"
msgstr "Ativar saída HDR10"

#: data/ui/page-gamescope.ui:269
msgid "SDR Content Nits"
msgstr "Nits do SDR"

#: data/ui/page-gamescope.ui:270
msgid "Brightness of SDR in HDR mode (default: 400)"
msgstr "Brilho do SDR em modo HDR (padrão: 400)"

#: data/ui/page-gamescope.ui:283
msgid "ITM Enabled"
msgstr "ITM Ativado"

#: data/ui/page-gamescope.ui:284
msgid "SDR to HDR inverse tone mapping"
msgstr "Mapeamento de tom inverso SDR para HDR"

#: data/ui/page-gamescope.ui:290
msgid "ITM SDR Nits"
msgstr "Nits SDR do ITM"

#: data/ui/page-gamescope.ui:291
msgid "SDR input luminance (default: 100)"
msgstr "Luminância de entrada SDR (padrão: 100)"

#: data/ui/page-gamescope.ui:304
msgid "ITM Target Nits"
msgstr "Nits Alvo do ITM"

#: data/ui/page-gamescope.ui:305
msgid "Target luminance (default: 1000)"
msgstr "Luminância alvo (padrão: 1000)"

#: data/ui/page-gamescope.ui:318
msgid "SDR Gamut Wideness"
msgstr "Amplitude do Gamut SDR"

#: data/ui/page-gamescope.ui:319
msgid "0.0 = standard, 1.0 = max"
msgstr "0.0 = padrão, 1.0 = máximo"

#: data/ui/page-gamescope.ui:349
msgid "Advanced"
msgstr "Avançado"

#: data/ui/page-gamescope.ui:350
msgid "Backend, mouse, keyboard, cursor and MangoApp settings."
msgstr ""
"Configurações de backend, mouse, teclado, cursor e MangoApp."

