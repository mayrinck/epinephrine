#: src/pages/page-hardware.c
msgid "Anti-Lag"
msgstr "Anti-Lag"

#: src/pages/page-hardware.c
msgid "Dynamically regulates your game's frame rate (FPS) based on your movements."
msgstr "Regula dinamicamente a taxa de quadros (FPS) do seu jogo com base nos seus movimentos."

#: src/pages/page-hardware.c
msgid "Forces the GPU to a specific performance level: auto, low power, high performance, or manual."
msgstr "Força a GPU para um nível específico de desempenho: automático, baixo consumo, alto desempenho ou manual."

#: src/pages/page-hardware.c
msgid "Controls GPU fan behavior. Enable manual mode to set fan speed (PWM) directly."
msgstr "Controla o comportamento da ventoinha da GPU. Ative o modo manual para definir a velocidade (PWM) diretamente."

#: src/pages/page-hardware.c
msgid "Official Page"
msgstr "Página Oficial"

#: src/pages/page-hardware.c
msgid "Release: %s"
msgstr "Lançamento: %s"

#: src/pages/page-hardware.c
msgid "Power Profile"
msgstr "Perfil de Energia"

#: src/pages/page-hardware.c
msgid "Selects the clock and power switching heuristic for the GPU."
msgstr "Seleciona a heurística de chaveamento de clock e energia da GPU."

#: src/pages/page-hardware.c
msgid "Frame Rate Target Control"
msgstr "Controle de Taxa de Quadros Alvo"

#: src/pages/page-hardware.c
msgid "Sets a maximum frame rate cap for all 3D applications via MangoHud."
msgstr "Define um limite máximo de taxa de quadros para todos os aplicativos 3D via MangoHud."

#: src/pages/page-hardware.c
msgid "FPS Limit"
msgstr "Limite de FPS"

#: src/pages/page-hardware.c
msgid "Power Limit (max)"
msgstr "Limite de Energia (máx)"

#: src/pages/page-hardware.c
msgid "Sets the maximum power consumption of the GPU in watts."
msgstr "Define o consumo máximo de energia da GPU em watts."

#: src/pages/page-hardware.c
msgid "Zero RPM Fan"
msgstr "Ventoinha Zero RPM"

#: src/pages/page-hardware.c
msgid "Allows the GPU fan to stop completely when the temperature is below the threshold."
msgstr "Permite que a ventoinha da GPU pare completamente quando a temperatura estiver abaixo do limite."

#: src/pages/page-hardware.c
msgid "Stop Temp"
msgstr "Temp. de Parada"

#: src/pages/page-hardware.c
msgid "Variable Rate Shading"
msgstr "Sombreamento de Taxa Variável"

#: src/pages/page-hardware.c
msgid "Reduces shading rate to boost performance (RDNA2+ GPU required)."
msgstr "Reduz a taxa de sombreamento para aumentar o desempenho (GPU RDNA2+ necessária)."

#: src/pages/page-hardware.c
msgid "Shading Rate"
msgstr "Taxa de Sombreamento"

#: src/pages/page-hardware.c
msgid "Select a device to view details"
msgstr "Selecione um dispositivo para ver detalhes"

#: src/pages/page-hardware.c
msgid "Devices"
msgstr "Dispositivos"
